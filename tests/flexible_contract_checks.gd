extends SceneTree
var checks = 0
var failures: Array = []
var fx = preload("res://tests/flexible_fixture.gd").new()
func check(ok: bool,label: String) -> void:
	checks += 1
	if not ok: failures.append(label)
func act(s: FlexibleContractSimulation,a: Dictionary) -> void:
	s.state.actor = 0
	check(s.apply(a).ok,"legal application: "+str(a))
	check(s.violations().is_empty(),"conservation after "+str(a)+": "+str(s.violations()))
func settle(s: FlexibleContractSimulation) -> void:
	act(s,{"type":"return_expedition"})
	for i in 6: check(s.apply({"type":"pass"}).ok,"normal travel action")
	check(s.trip_by_id(1).status == "home","crew really returned")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var ai = PlannerAI.new()
	var s: FlexibleContractSimulation = fx.fixture(7,true)
	var before = TownSimulation.canonical(s.snapshot())
	var d = ai.decide(s)
	check(before == TownSimulation.canonical(s.snapshot()),"planner and RNG inspection is pure")
	check(d.plan.has("goal") and d.plan.has("budget") and d.plan.has("next_action"),"inspectable planning record")
	check(d.chosen == {"type":"expedition_contract","offer":0,"access":"public"},"nonessential town buffer chooses public bridge")
	check(ai.assess_offer(s,s.trip_for("blue").buy[0],"public").exit_prestige == 0,"public exit has no prestige barrier")
	var wallet = s.house("blue").inventory.duplicate()
	act(s,d.chosen)
	var route: Dictionary = s.route_by_id(1)
	check(s.house("blue").inventory.prestige == wallet.prestige-1,"one prestige setup and no unearned clay reward")
	check(s.house("blue").inventory.influence == wallet.influence,"public setup does not buy priority")
	check(s.transport_free("blue") == 0,"public route commits real transport")
	settle(s)
	var delivered = int(route.delivered)
	var cash = int(s.house("blue").inventory.gold)
	s._close_round()
	check(route.delivered == delivered+1 and s.house("blue").inventory.gold == cash-1,"public shipment still costs gold")
	check(s.state.lots.any(func(l): return l.source == "expedition_route" and l.resource == "clay" and l.reserved_for == ""),"public output immediately circulates")
	check(s.state.exploration.clay_rewarded and s.state.exploration.clay_reward_events.size() == 1,"town reward follows a real delivery once")
	var old_lots = s.state.lots.filter(func(l): return l.source == "expedition_route").map(func(l): return l.id)
	s._gain_influence("blue",2,"fixture",[])
	wallet = s.house("blue").inventory.duplicate()
	act(s,{"type":"own_route","route":1})
	check(s.house("blue").inventory.influence == wallet.influence-2 and route.access == "priority","ownership consumes actual influence")
	check(s.state.lots.filter(func(l): return l.id in old_lots).all(func(l): return l.reserved_for == ""),"ownership is not retroactive")
	s._close_round()
	check(s.state.lots.any(func(l): return l.source == "expedition_route" and l.reserved_for == "blue"),"future priority reserves a shipment")
	check(s.route_cancel_price(route,"blue") == 1 and s.route_cancel_price(route,"red") == 8,"cheap own withdrawal and expensive hostile interference")
	wallet = s.house("blue").inventory.duplicate()
	act(s,{"type":"cancel_route","route":1})
	check(not route.active and s.transport_free("blue") == 1 and s.house("blue").inventory.prestige == wallet.prestige-1,"owned exit pays and frees transport")
	s = fx.fixture(1,true)
	act(s,{"type":"expedition_contract","offer":0,"access":"public"})
	fx.wallet(s,0,0)
	s.state.actor = 0
	check(ai.decide(s).chosen == {"type":"cancel_route","route":1},"stop unfunded public route")
	act(s,{"type":"cancel_route","route":1})
	check(not s.state.exploration.clay_rewarded,"sign and cancel cannot earn a clay reward")
	check(s.transport_free("blue") == 0,"cancel does not teleport a travelling expedition")
	settle(s)
	check(s.transport_free("blue") == 1,"real return releases transport")
	s = fx.fixture(42,true)
	s._gain_influence("blue",2,"fixture",[])
	wallet = s.house("blue").inventory.duplicate()
	act(s,{"type":"expedition_contract","offer":0,"access":"priority"})
	check(s.house("blue").inventory.influence == wallet.influence-2,"priority establishment consumes influence")
	settle(s)
	fx.build(s,"hall_red")
	s._prestige("red",20,"fixture",[])
	s._gain_influence("red",4,"fixture",[])
	s.state.actor = 1
	wallet = s.house("red").inventory.duplicate()
	var result = s.apply({"type":"buy_route","route":1})
	check(result.ok and s.violations().is_empty(),"legal rival route buyout")
	check(s.house("red").inventory.prestige == wallet.prestige-5 and s.house("red").inventory.influence == wallet.influence-2,"buyout pays prestige and influence")
	check(s.route_by_id(1).price == 7 and s.transport_free("blue") == 1 and s.transport_free("red") == 0,"buyout escalates price and transfers liability")
	s = fx.fixture(7,false)
	check(ai.decide(s).chosen == {"type":"expedition_buy","offer":0},"small finite need avoids standing obligation")
	act(s,{"type":"expedition_buy","offer":0})
	check(ai.needed_units(s,"clay") == 1,"paid returning cargo reduces outstanding need")
	s = fx.fixture(7,true)
	act(s,{"type":"expedition_contract","offer":0,"access":"public"})
	var clone = FlexibleContractSimulation.new()
	clone.restore(JSON.parse_string(JSON.stringify(s.snapshot())))
	check(TownSimulation.canonical(s.snapshot()) == TownSimulation.canonical(clone.snapshot()),"exact save/restore of access and commitments")
	check(ai.decide(s).chosen == ai.decide(clone).chosen,"same choice after save/restore")
	fx.fund(s,"brick",5)
	s.state.actor = 0
	check(ai.route_budget(s,s.route_by_id(1)).stop and ai.decide(s).chosen == {"type":"cancel_route","route":1},"replan when other supply satisfies goal")
	s = fx.fixture(42,true,false)
	fx.wallet(s,6,2)
	s._gain_influence("blue",2,"fixture",[])
	s.state.actor = 0
	check(ai.decide(s).chosen == {"type":"expedition_contract","offer":0,"access":"public"},"one private home input does not justify buying whole-flow priority")
	var value = ai.priority_value(s,"clay")
	check(value.private_units == 1 and ai.needed_units(s,"clay") > 1 and value.access_cost_upper_influence == 2 and not value.justified,"distinguish private milestone need from global import target")
	var balance = int(s.house("blue").inventory.influence)
	s.house("blue").inventory.influence = 0
	s.state.ledger.influence.consumed += balance
	check({"type":"expedition_contract","offer":0,"access":"priority"} not in s.legal_actions(),"ownership needs actual influence")
	check({"type":"expedition_contract","offer":0,"access":"public"} in s.legal_actions(),"public remains legal without ownership influence")
	s = fx.fixture(7,true)
	fx.fund(s,"wood",1)
	fx.fund(s,"pop",1)
	act(s,{"type":"secure_contract","resource":"wood","source":"lumber_camp"})
	s.state.actor = 0
	check(s.cancel_price("wood") == 0,"local public creator can exit freely")
	s._gain_influence("blue",2,"fixture",[])
	wallet = s.house("blue").inventory.duplicate()
	act(s,{"type":"buy_contract","resource":"wood"})
	s.state.actor = 0
	check(s.cancel_price("wood") == 1 and s.house("blue").inventory.influence == wallet.influence-2,"local title ownership consumes influence and gets cheap own exit")
	s.state.actor = 1
	check(s.cancel_price("wood") >= 8,"local rival cancellation remains expensive")
	var out = {"checks":checks,"failures":failures}
	DirAccess.make_dir_recursive_absolute("res://experiments/flexible_checks")
	FileAccess.open("res://experiments/flexible_checks/results.json",FileAccess.WRITE).store_string(JSON.stringify(out,"\t"))
	print(JSON.stringify(out))
	quit(0 if failures.is_empty() else 1)
